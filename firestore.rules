rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminList() {
      return get(/databases/$(database)/documents/admins/list).data;
    }

    function isAdmin() {
      return signedIn() &&
             exists(/databases/$(database)/documents/admins/list) &&
             (request.auth.uid in adminList().adminIds ||
              request.auth.uid == adminList().superAdminId);
    }

    function isSuperAdmin() {
      return signedIn() &&
             exists(/databases/$(database)/documents/admins/list) &&
             request.auth.uid == adminList().superAdminId;
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    // Only the listed fields change in this update.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A like toggle: only likedBy/likeCount change, and the caller only adds
    // or removes their own uid.
    function isOwnLikeToggle() {
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      return onlyChanges(['likedBy', 'likeCount']) &&
             after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // Document IDs shaped like "<uid>_<something>" belong to <uid>.
    function idOwnedByCaller(docId) {
      return signedIn() && docId.matches(request.auth.uid + '_.+');
    }

    // ---------- Users ----------

    match /users/{userId} {
      // Profiles are visible to signed-in users only. Email addresses are no
      // longer stored here (see UserDataService).
      allow read: if signedIn();
      allow create: if isSelf(userId);
      // Owners can edit their profile; anyone else may only bump the follower
      // counter as part of a follow/unfollow.
      allow update: if isSelf(userId) ||
                    (signedIn() && onlyChanges(['followers', 'updatedAt']));
      allow delete: if isSelf(userId);

      match /ratings/{gameId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(userId);
        allow update: if isSelf(userId) ||
                      (signedIn() && (isOwnLikeToggle() || onlyChanges(['commentCount'])));
      }

      match /library/{gameId} {
        allow read, write: if isSelf(userId);
      }

      match /playlists/{playlistId} {
        allow read: if isSelf(userId) ||
                    (signedIn() && resource != null && resource.data.isPublic == true);
        allow write: if isSelf(userId);
      }

      match /following/{targetUserId} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }

      // The follower writes their own entry into the target's followers list.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(followerId) && followerId != userId;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      }
    }

    // ---------- Legacy flat collections (doc ID = "<uid>_<gameId>") ----------

    match /user_library/{entryId} {
      // get works even for missing docs; list must filter on userId.
      allow get: if idOwnedByCaller(entryId);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if idOwnedByCaller(entryId) &&
                            request.resource.data.userId == request.auth.uid;
      allow delete: if idOwnedByCaller(entryId);
    }

    match /user_ratings/{ratingId} {
      allow read: if signedIn();
      allow create, update: if idOwnedByCaller(ratingId) &&
                            request.resource.data.userId == request.auth.uid;
      allow delete: if idOwnedByCaller(ratingId) || isAdmin();
    }

    // ---------- Ratings ----------

    match /game_ratings/{ratingId} {
      allow read: if true;
      allow create: if idOwnedByCaller(ratingId) && !isBanned() &&
                    request.resource.data.userId == request.auth.uid;
      allow update: if (idOwnedByCaller(ratingId) &&
                        request.resource.data.userId == request.auth.uid) ||
                    (signedIn() && (isOwnLikeToggle() || onlyChanges(['commentCount'])));
      allow delete: if idOwnedByCaller(ratingId) || isAdmin();
    }

    match /rating_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() &&
                    request.resource.data.authorId == request.auth.uid;
      allow update: if (signedIn() && resource.data.authorId == request.auth.uid &&
                        request.resource.data.authorId == request.auth.uid) ||
                    (signedIn() && isOwnLikeToggle());
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ---------- Forum ----------

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() &&
                    request.resource.data.authorId == request.auth.uid;
      allow update: if (signedIn() && resource.data.authorId == request.auth.uid &&
                        onlyChanges(['content', 'updatedAt', 'isEdited'])) ||
                    (signedIn() && isOwnLikeToggle()) ||
                    // Replying bumps the parent's reply counter.
                    (signedIn() && onlyChanges(['replyCount', 'updatedAt'])) ||
                    isAdmin();
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ---------- Friends ----------

    // Friendship docs are stored in both directions: "<a>_<b>" and "<b>_<a>".
    match /friends/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
                    request.auth.uid in [request.resource.data.userId1, request.resource.data.userId2] &&
                    friendshipId == request.resource.data.userId1 + '_' + request.resource.data.userId2;
      allow delete: if signedIn() &&
                    (resource == null ||
                     request.auth.uid in [resource.data.userId1, resource.data.userId2]);
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() &&
                  (resource.data.fromUserId == request.auth.uid ||
                   resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() &&
                    request.resource.data.fromUserId == request.auth.uid &&
                    request.resource.data.toUserId != request.auth.uid &&
                    request.resource.data.status == 'pending';
      // Only the recipient accepts or declines.
      allow update: if signedIn() &&
                    resource.data.toUserId == request.auth.uid &&
                    onlyChanges(['status', 'acceptedAt', 'declinedAt']);
      allow delete: if signedIn() &&
                    (resource.data.fromUserId == request.auth.uid ||
                     resource.data.toUserId == request.auth.uid);
    }

    // ---------- Admin ----------

    // admins/list is bootstrapped once from the Firebase console
    // (see docs/ADMIN_SETUP.md). Clients can never create it.
    match /admins/{doc} {
      allow read: if signedIn();
      allow update: if doc == 'list' && isSuperAdmin() &&
                    request.resource.data.superAdminId == resource.data.superAdminId &&
                    request.resource.data.superAdminId in request.resource.data.adminIds;
      allow create, delete: if false;
    }

    match /banned_users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
